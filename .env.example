# Copy to .env and fill with values from your Supabase project
# Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key

# Optional server aliases used by Vercel/Lovable functions
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key

# Optional AI / Speech Recognition keys:
# If unset, speech-to-text automatically falls back to browser Web Speech API (Chrome/Edge/Safari/Android).
# LOVABLE_API_KEY=your-lovable-gateway-api-key
# OPENAI_API_KEY=your-openai-api-key
